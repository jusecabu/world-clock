---
import { describeWeather } from '../../domain/weather';

type Props = { code: number; isDay?: boolean; size?: number; title?: string };
const { code, isDay = true, size = 48, title } = Astro.props;
const { icon, label } = describeWeather(code);

const hasCloud = icon !== 'clear';
const showSun = (icon === 'clear' || icon === 'partly') && isDay;
const showMoon = (icon === 'clear' || icon === 'partly') && !isDay;
const small = icon === 'partly';
---

<svg
	class="weather-icon"
	width={size}
	height={size}
	viewBox="0 0 48 48"
	role="img"
	aria-label={title ?? label}
	fill="none"
	stroke="var(--color-ink)"
	stroke-width="2.6"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		showSun && (
			<g transform={small ? 'translate(-6 -7) scale(.85)' : undefined}>
				<circle cx="24" cy="24" r="8.5" fill="var(--lichen-400)" />
				<path d="M24 6v5M24 37v5M6 24h5M37 24h5M11.3 11.3l3.5 3.5M33.2 33.2l3.5 3.5M11.3 36.7l3.5-3.5M33.2 14.8l3.5-3.5" />
			</g>
		)
	}
	{
		showMoon && (
			<g transform={small ? 'translate(-6 -7) scale(.85)' : undefined}>
				<path d="M30 8a15 15 0 1 0 10 25A13 13 0 0 1 30 8z" fill="var(--mist-200)" />
				<circle cx="16" cy="16" r="1.2" fill="var(--color-ink)" stroke="none" />
				<circle cx="22" cy="34" r="1.2" fill="var(--color-ink)" stroke="none" />
			</g>
		)
	}
	{
		hasCloud && (
			<path
				d="M14 34h21a7.5 7.5 0 0 0 0-15 10.5 10.5 0 0 0-20-2.5A8.75 8.75 0 0 0 14 34z"
				fill={icon === 'storm' ? 'var(--sage-400)' : icon === 'partly' ? 'var(--moss-50)' : 'var(--mist-100)'}
				transform={icon === 'cloudy' || icon === 'partly' ? 'translate(0 3)' : 'translate(0 -4)'}
			/>
		)
	}
	{icon === 'fog' && <path d="M10 37h28M14 42h22" />}
	{icon === 'rain' && <path stroke="var(--mist-700)" d="M17 35l-3 6M25 35l-3 6M33 35l-3 6" />}
	{
		icon === 'drizzle' && (
			<g fill="var(--mist-700)" stroke="none">
				<circle cx="16" cy="38" r="1.8" />
				<circle cx="24" cy="41" r="1.8" />
				<circle cx="32" cy="38" r="1.8" />
			</g>
		)
	}
	{icon === 'snow' && <path d="M16 36v6M13 39h6M30 36v6M27 39h6M23 40v5M20.5 42.5h5" />}
	{icon === 'storm' && <path d="M25 31l-5 8h6l-4 7" stroke="var(--color-ink)" fill="var(--lichen-400)" />}
</svg>

<style>
	.weather-icon {
		flex: none;
	}
</style>
