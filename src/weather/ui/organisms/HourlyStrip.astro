---
import Surface from '@shared/ui/atoms/Surface.astro';
import Heading from '@shared/ui/atoms/Heading.astro';
import HourItem from '../molecules/HourItem.astro';
import type { HourlyForecast } from '../../domain/weather';

type Props = { hours: HourlyForecast[] };
const { hours } = Astro.props;
---

{
	hours.length > 0 && (
		<Surface as="section" tone="surface" class="hourly" aria-labelledby="proximas-horas">
			<Heading level={2} size="md" id="proximas-horas">
				Próximas 24 horas
			</Heading>
			<ol class="hourly__list" tabindex="0" aria-label="Pronóstico por horas, desplázate horizontalmente">
				{hours.map((h, i) => (
					<HourItem hour={h} isNow={i === 0} />
				))}
			</ol>
		</Surface>
	)
}

<style>
	.hourly {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		min-width: 0;
	}
	.hourly__list {
		display: flex;
		gap: var(--space-2);
		margin: 0;
		padding: 0 0 var(--space-3);
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-color: var(--color-ink) var(--moss-100);
	}
</style>
