---
import Logo from '../atoms/Logo.astro';
import { SITE } from '@seo/domain/site';

const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Mi reloj' },
	{ href: '/zonas', label: 'Todas las zonas' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="brand" aria-label={`${SITE.name}, ir al inicio`}>
			<Logo size={42} />
			<span class="brand__text">
				<strong>{SITE.name}</strong>
				<small>{SITE.tagline}</small>
			</span>
		</a>
		<nav aria-label="Principal">
			<ul class="nav">
				{
					links.map((l) => (
						<li>
							<a href={l.href} class="nav__link" aria-current={isActive(l.href) ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		padding-block: var(--space-4);
		background: var(--moss-200);
		border-bottom: var(--border);
	}
	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		text-decoration: none;
	}
	.brand__text {
		display: grid;
		line-height: 1.1;
	}
	.brand__text strong {
		font-size: var(--fs-lg);
		letter-spacing: -0.02em;
	}
	.brand__text small {
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		color: var(--color-ink-soft);
	}
	.nav {
		display: flex;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.nav__link {
		display: block;
		padding: var(--space-1) var(--space-3);
		font-weight: 700;
		text-decoration: none;
		border: 2px solid transparent;
		border-radius: var(--radius-sm);
	}
	.nav__link:hover {
		border-color: var(--color-ink);
		background: var(--color-surface);
	}
	.nav__link[aria-current='page'] {
		background: var(--color-highlight);
		border-color: var(--color-ink);
		box-shadow: var(--shadow-sm);
	}
</style>
