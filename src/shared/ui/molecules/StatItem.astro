---
type Props = { label: string; value?: string; hint?: string };
const { label, value, hint } = Astro.props;
---

<div class="stat">
	<dt class="stat__label">{label}</dt>
	<dd class="stat__value">{value}<slot /></dd>
	{hint && <dd class="stat__hint">{hint}</dd>}
</div>

<style>
	.stat {
		display: grid;
		align-content: start;
		gap: 0.1rem;
		padding: var(--space-3);
		background: var(--color-surface);
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-sm);
	}
	.stat__label {
		font-size: var(--fs-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-ink-soft);
	}
	.stat__value {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--fs-lg);
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	.stat__hint {
		margin: 0;
		font-size: var(--fs-xs);
		color: var(--color-ink-soft);
	}
</style>
