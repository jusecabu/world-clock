---
import Heading from '../atoms/Heading.astro';

type Props = { eyebrow?: string; title: string; description?: string; level?: 1 | 2 | 3; id?: string };
const { eyebrow, title, description, level = 2, id } = Astro.props;
---

<header class="section-title">
	{eyebrow && <p class="section-title__eyebrow">{eyebrow}</p>}
	<Heading level={level} size="lg" id={id}>{title}</Heading>
	{description && <p class="section-title__desc">{description}</p>}
	<slot />
</header>

<style>
	.section-title {
		display: grid;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}
	.section-title__eyebrow {
		justify-self: start;
		padding: 0.1rem 0.6rem;
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		background: var(--color-highlight);
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-sm);
		transform: rotate(-1.5deg);
	}
	.section-title__desc {
		max-width: 62ch;
		color: var(--color-ink-soft);
	}
</style>
