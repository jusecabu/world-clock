---
type Props = { data: object | object[] };
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
// Escapamos "<" para que el JSON nunca pueda cerrar la etiqueta <script>.
const serialize = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c');
---

{items.map((item) => <script type="application/ld+json" is:inline set:html={serialize(item)} />)}
