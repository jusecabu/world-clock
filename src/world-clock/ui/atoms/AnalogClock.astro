---
import { getClockParts } from '../../domain/time';

type Props = { timeZone: string; clientTimeZone?: string; now?: Date; size?: number };
const { timeZone, clientTimeZone, now = new Date(), size = 180 } = Astro.props;
const { h, m, s } = getClockParts(timeZone, now);
const style = `--h:${(h % 12) + m / 60};--m:${m + s / 60};--s:${s};--size:${size}px`;
const ticks = Array.from({ length: 12 }, (_, i) => i);
---

<div class="analog" data-analog data-tz={clientTimeZone ?? timeZone} style={style} aria-hidden="true">
	<svg viewBox="0 0 100 100">
		<!-- Sombra dura dibujada en el propio SVG: pegada al borde del círculo, sin hueco -->
		<circle cx="54" cy="54" r="46" class="analog__shadow"></circle>
		<circle cx="50" cy="50" r="46" class="analog__face"></circle>
		{ticks.map((i) => <rect x="48.5" y="8" width="3" height={i % 3 === 0 ? 9 : 5} rx="1" transform={`rotate(${i * 30} 50 50)`} class="analog__tick" />)}
		<line x1="50" y1="50" x2="50" y2="27" class="analog__hand analog__hand--h"></line>
		<line x1="50" y1="50" x2="50" y2="16" class="analog__hand analog__hand--m"></line>
		<line x1="50" y1="58" x2="50" y2="14" class="analog__hand analog__hand--s"></line>
		<circle cx="50" cy="50" r="4" class="analog__pin"></circle>
	</svg>
</div>

<style>
	.analog {
		width: var(--size);
		aspect-ratio: 1;
		flex: none;
	}
	.analog__shadow {
		fill: var(--color-ink);
		stroke: var(--color-ink);
		stroke-width: 3;
	}
	.analog svg {
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.analog__face {
		fill: var(--color-surface);
		stroke: var(--color-ink);
		stroke-width: 3;
	}
	.analog__tick {
		fill: var(--color-ink);
	}
	.analog__hand {
		stroke: var(--color-ink);
		stroke-linecap: round;
		transform-origin: 50px 50px;
	}
	.analog__hand--h {
		stroke-width: 5;
		transform: rotate(calc(var(--h) * 30deg));
	}
	.analog__hand--m {
		stroke-width: 3.5;
		transform: rotate(calc(var(--m) * 6deg));
	}
	.analog__hand--s {
		stroke: var(--clay-500);
		stroke-width: 1.8;
		transform: rotate(calc(var(--s) * 6deg));
	}
	.analog__pin {
		fill: var(--clay-500);
		stroke: var(--color-ink);
		stroke-width: 2;
	}
</style>
